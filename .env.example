# Copy this file to .env (which is git-ignored) and fill in every value.
# Generate each one with:  openssl rand -hex 24
# Compose refuses to start while any is empty.
# INTERNAL_AUTH_SECRET is the HMAC secret the services sign their calls to each
# other with: every service must share the same value, at least 32 characters.
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
INTERNAL_AUTH_SECRET=
